:root {
    --color-background: #ffffff;
    --color-text: #262323;
    --color-text-muted: #534d4d;
    --color-accent: #7d3302;
    --color-border: #e5e5e5;

    --font-main: Arial, Helvetica, sans-serif;
}


html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    padding: 0;

    background: var(--color-background);
    color: var(--color-text);

    font-family: var(--font-main);
    -webkit-font-smoothing: antialiased;
}

img {
    display: block;
    max-width: 100%;
    height: auto;
}

a {
    color: inherit;
}


.header {
    position: static;
    background: transparent;
}

.header__nav {
    width: 100%;
}

.menu {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;

    gap: 70px;

    margin: 0;
    padding: 25px 50px;

    list-style: none;
}

.menu__item {
    margin: 0;
}

.menu__link {
    display: inline-block;

    color: var(--color-accent);
    text-decoration: none;

    font-size: 20px;
    font-weight: 500;
}

.menu__link:hover {
    text-decoration: underline;
}

.menu__link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
}


.hero {
    width: 100%;
}

.hero__image {
    width: 100%;
    height: min(100vh, 900px);

    object-fit: cover;
}


.collections {
    padding: 70px 50px;
}

.collections__header {
    margin-bottom: 40px;
}

.collections__title {
    margin: 0 0 20px;

    color: var(--color-text);

    font-size: clamp(36px, 5vw, 50px);
    line-height: 1.1;
    font-weight: 500;
}

.collections__text {
    margin: 0;

    color: var(--color-text-muted);

    font-size: 20px;
    line-height: 1.5;
    font-weight: 300;
}


.products {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));

    gap: 40px;
}

.product-card {
    min-width: 0;
}

.product-card__image {
    width: 100%;
    max-width: 600px;

    border-radius: 5px;

    transition: transform 0.4s;
}

@media (hover: hover) and (pointer: fine) {
    .product-card__image:hover {
        transform: scale(1.03);
    }
}

.product-card__text {
    margin: 15px 0;

    color: var(--color-text-muted);

    font-size: 15px;
    line-height: 1.5;
    font-weight: 300;
}

.product-card__button {
    margin-top: 5px;
}


.button {
    display: inline-block;

    width: fit-content;

    padding: 8px 0;

    color: var(--color-text);

    font-size: 20px;
    font-weight: 300;
    font-family: var(--font-main);

    text-decoration: none;

    background: transparent;
    border: 0;

    cursor: pointer;
}

.button:hover {
    color: var(--color-accent);
}

.button:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
}

.about {
    margin-top: 70px;
    padding-bottom: 70px;
}

.about__content {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);

    gap: 40px;

    align-items: center;
}

.about__image-wrapper {
    min-width: 0;
}

.about__image {
    width: 100%;
    max-width: 700px;

    height: auto;

    border-radius: 0 5px 5px 0;
}

.about__info {
    min-width: 0;
    padding: 0 40px;
}

.about__title {
    margin: 0 0 40px;

    color: #3a3636;

    font-size: clamp(36px, 5vw, 50px);
    line-height: 1.1;
    font-weight: 500;
}

.about__text {
    margin: 0 0 20px;

    color: var(--color-text-muted);

    font-size: 20px;
    line-height: 1.6;
    font-weight: 300;
}

.footer {
    padding: 20px 50px;

    background: #ffffff;
    color: var(--color-accent);

    font-family: var(--font-main);
}

.footer__contacts {
    display: flex;
    justify-content: space-between;
    align-items: center;

    gap: 20px;

    margin: 0;

    font-style: normal;
}

.footer__link {
    color: var(--color-accent);
    text-decoration: none;
}

.footer__link:hover {
    text-decoration: underline;
}

.footer__link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
}

.footer__logo {
    text-align: center;
}


@media (max-width: 900px) {

    .menu {
        gap: 30px;
        padding: 20px 30px;
    }

    .menu__link {
        font-size: 18px;
    }

    .collections {
        padding: 50px 30px;
    }

    .products {
        grid-template-columns: 1fr;
    }

    .product-card__image {
        max-width: 100%;
    }

    .about {
        padding: 0 30px 50px;
    }

    .about__content {
        grid-template-columns: 1fr;
    }

    .about__image {
        max-width: 100%;
        border-radius: 5px;
    }

    .about__info {
        padding: 0;
    }

    .dealer {
        padding: 40px 30px;
    }

    .footer {
        padding: 20px 30px;
    }

    .footer__contacts {
        flex-direction: column;
        text-align: center;
    }
}


@media (max-width: 600px) {

    .menu {
        gap: 15px 25px;
        padding: 15px 20px;
    }

    .menu__link {
        font-size: 16px;
    }

    .hero__image {
        height: 60vh;
        min-height: 350px;
    }

    .collections {
        padding: 40px 20px;
    }

    .collections__text {
        font-size: 16px;
    }

    .about {
        margin-top: 30px;
        padding: 0 20px 40px;
    }

    .about__text {
        font-size: 17px;
    }

    .dealer {
        padding: 30px 20px;
    }

    .footer {
        padding: 20px;
    }
}


@media (prefers-reduced-motion: reduce) {

    html {
        scroll-behavior: auto;
    }

    .product-card__image {
        transition: none;
    }
}
