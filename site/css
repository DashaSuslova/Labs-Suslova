body{
    margin: 0;
    padding: 0;
}
header{
     position: static;
     background: transparent;
}
li{
    display: inline-block;
    list-style: none;
    
}

a{
    text-decoration: none;      
    color: #7d3302;             
    font-weight: 500;           
    font-size: 20px;               
    font-family: Arial, Helvetica, sans-serif;
    margin-left: 200px;
    text-align: center;
}

.CTA img{
    width: 100%;
    height: 100vh;                  
    object-fit: cover; 
    display: flex;
}
.Pr1 h2{
    color: #262323;             
    font-weight: 500;           
    font-size: 50px;               
    font-family: Arial, Helvetica, sans-serif;
    margin-left: 50px;
    text-align: left;
}
.Pr1 p{
    color: #534d4d;             
    font-weight: 300;           
    font-size: 20px;               
    font-family: Arial, Helvetica, sans-serif;
    margin-left: 50px;
    text-align: left;
}
.Pr2 {
  display: flex;              
  justify-content: space-between; 
}

.cards {
  margin-top: 10px;
  flex: 2;                     
  display: flex;
  flex-direction: column;   
  margin-left: 50px;   
}

.cards img {
  width: 80%;                
  height: auto;
  border-radius: 5px;
  transition: transform 0.4s;
}

.cards img:hover{
    transform: scale(1.05);
}

.Pr2 p{
     color: #534d4d;             
    font-weight: 300;           
    font-size: 15px;               
    font-family: Arial, Helvetica, sans-serif;
    text-align: left;
}

button {
  border: 0;
  background-color: #ffffff;
  width: 200px;
  height: 30px;
  color: #262323;             
  font-weight: 300;           
  font-size: 20px;               
  font-family: Arial, Helvetica, sans-serif;
  text-align: left;
}
button:hover{
  color: #7d3302;
}
.AU {
    display: flex;
    gap: 40px;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 70px;
  }
.Aucards {
     flex: 1 1 45%; 
     min-width: 300px; 
}
.Aucards img { 
     width: 84%;
     height: 700px;
     border-radius: 0 5px 5px 0 ;
}
.AU h2{
    color: #3a3636;             
    font-weight: 500;           
    font-size: 50px;               
    font-family: Arial, Helvetica, sans-serif;
    text-align: left;
    margin-bottom: 50px;
}
.AU p{
   color: #534d4d;             
    font-weight: 300;           
    font-size: 20px;               
    font-family: Arial, Helvetica, sans-serif;
    text-align: left; 
}
.footer p{
    display: inline-block;
    margin-left: 20px;
}
.footer {
  background-color: #ffffff;
  color: #7d3302;
  padding: 20px 0;
  text-align: center;
  font-family: Arial, Helvetica, sans-serif;
  font-size: 14px;
}
